{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yakov-logjam",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "logjam.shmol.cc",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yakov_archive",
      "database_id": "ef77bda3-ed15-4ae5-8bde-17cfea8bb0e5",
      "migrations_dir": "../migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "DECISION_RATE_LIMITER",
      "namespace_id": "1001001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PRIVATE_MUTATION_RATE_LIMITER",
      "namespace_id": "1001002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "RUNTIME_ENV": "production",
    "ACCESS_ENABLED": "true",
    "ACCESS_TEAM_DOMAIN": "https://calm-math-532f.cloudflareaccess.com",
    "ACCESS_APP_AUD": "2a1d0aa0eb0d824eff233d9d5f204640bfa75747c4573a5c955f3e683e4c1334"
  }
}
